# The kaji agent of this host (see docs/hosts.rst in the kaji repository). Mode 0600, root only: it holds the token (systemd reads it as root).
#
# The token of the agent made in the console (Agents, role host); shown once, when the agent is made.
KAJI_TOKEN=
# Or, for many hosts: an enrollment token of the organization (Enrollment tokens in the console), the same on all of them. The agent registers itself under
# its hostname, keeps the token it gets in /var/lib/kaji-agent/token and uses that from then on. Leave KAJI_TOKEN empty. To enroll a host again, revoke its
# agent in the console and delete that file.
#KAJI_ENROLL_TOKEN=
# The name to enroll under (default: the hostname).
#KAJI_NAME=
# The gateway; this is the default.
#KAJI_URL=wss://console.kaji.systems/agent/ws
# Seconds between reports (default 21600, six hours; at least 60).
#KAJI_REPORT_INTERVAL=21600
